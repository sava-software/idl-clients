# Whitelist .gitignore: everything is ignored by default and tracked content is
# re-included explicitly below. Adding a new kind of tracked file means adding a
# rule here — that is the point. Build output, tool artifacts (Jazzer crash and
# slow-unit reproducers, PIT reports) and scratch files cannot be committed by
# accident, because nothing is tracked unless it is named here.

# Ignore everything, but keep descending into directories so the rules below can
# re-include their contents.
*
!*/

# Root
!/.gitignore
!/.release-please-manifest.json
!/AGENTS.md
!/arcmutate-licence.txt
!/CHANGELOG.md
!/LICENSE
!/README.md
!/gradle.properties
!/gradlew
!/gradlew.bat
!/main_net_programs.json
!/release-please-config.json
!/settings.gradle.kts

# CI, the Gradle wrapper, and shared build config
!/.github/**
!/gradle/**

# IDLs a program is generated from when its config names a committed file rather than a
# URL — `idlFile` in main_net_programs.json. Empty since 2026-08-25, when Stake became the
# last program to move to `idlURL`. The rule stays: a future `idlFile` would land here and,
# with nothing re-including it, be swallowed silently.
!/idls/**

# Agent/developer tooling and the long-form docs AGENTS.md links to. Both are a
# new kind of tracked file, so they need explicit rules under the whitelist.
!/docs/**
!/tools/*.md
# Run straight from source (`java tools/GroundTruth.java`) — deliberately not Gradle
# modules, so they stay out of the build, the publish, and the mutation-ownership audit.
!/tools/*.java
# stake-vectors.mjs renders the committed Stake reference encodings from upstream's own
# generated JS client; committed because the script is the provenance of a tracked fixture.
!/tools/*.mjs

# Both reports idl-src-gen emits from one run: the movement events this run saw, and the
# standing gap dashboard beside it. The gap file needs its own rule — it is named by the
# generator rather than by the --report flag, so nothing here would have re-included it and
# the catch-all above would swallow a committed deliverable silently.
!/idl-change-report.txt
!/idl-change-report-gap.txt

# Modules: sources (hand-written and generated), build scripts, docs, the idl.json
# each generated package was produced from, test fixtures and fuzz seed corpora,
# and the mutation baselines the quality gate ratchets against
!/idl-clients-*/**/*.java
!/idl-clients-*/**/*.kts
!/idl-clients-*/**/*.md
!/idl-clients-*/**/*.json
!/idl-clients-*/src/test/resources/**
!/idl-clients-*/config/pitest/**

# Integration-style scratch files are never committed, even though they are .java
# and would otherwise match the source rule above (see AGENTS.md).
Integ.*

# Re-ignore tool and IDE output that the broad source rules above would otherwise
# pull back in (build/generated/**/*.java, reports, ...). Last match wins, and an
# ignored directory is never descended into.
build/
out/
bin/
.gradle/
.idea/
.kotlin/
node_modules/
